<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow">
      <div class="card-body p-4">
        <h3 class="mb-3">Pesan Tiket</h3>
        <h5><%= event.title %></h5>
        <p class="text-muted">
          <i class="bi bi-calendar-event"></i> <%= new Date(event.date).toLocaleDateString('id-ID', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %><br>
          <i class="bi bi-geo-alt"></i> <%= event.location %><br>
          <strong>Harga:</strong> Rp <%= Number(event.ticket_price).toLocaleString('id-ID') %> / tiket
        </p>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <form method="POST" action="/orders/create/<%= event.id %>">
          <div class="mb-3">
            <label class="form-label">Jumlah Tiket</label>
            <input type="number" name="quantity" class="form-control" min="1" max="<%= event.ticket_quota %>" value="1" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Buat Pesanan</button>
          <a href="/events/<%= event.id %>" class="btn btn-secondary w-100 mt-2">Kembali</a>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
