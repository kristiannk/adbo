<%- include('../partials/header') %>
<h3 class="mb-4">Admin Dashboard</h3>
<div class="row">
  <div class="col-md-3 mb-3">
    <div class="card bg-primary text-white">
      <div class="card-body text-center">
        <h1><%= stats.users %></h1>
        <p class="mb-0">Total User</p>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card bg-success text-white">
      <div class="card-body text-center">
        <h1><%= stats.events %></h1>
        <p class="mb-0">Total Event</p>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card bg-info text-white">
      <div class="card-body text-center">
        <h1><%= stats.orders %></h1>
        <p class="mb-0">Total Pesanan</p>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card bg-warning text-white">
      <div class="card-body text-center">
        <h1>Rp <%= Number(stats.revenue).toLocaleString('id-ID') %></h1>
        <p class="mb-0">Pendapatan</p>
      </div>
    </div>
  </div>
</div>
<div class="row mt-3">
  <div class="col-md-4">
    <a href="/admin/users" class="btn btn-outline-primary w-100 mb-2">Kelola User</a>
  </div>
  <div class="col-md-4">
    <a href="/admin/events" class="btn btn-outline-success w-100 mb-2">Kelola Event</a>
  </div>
  <div class="col-md-4">
    <a href="/admin/orders" class="btn btn-outline-info w-100 mb-2">Kelola Pesanan</a>
  </div>
</div>
<%- include('../partials/footer') %>
